# Generate independent random values: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=replace-with-at-least-32-random-characters
ADMIN_SETUP_TOKEN=replace-with-a-separate-random-setup-token
# Every additional real agency has its own setup token; never reuse Martinez's token.
ADMIN_SETUP_TOKEN_SOLANO_COUNTY=
APP_URL=http://localhost:3000
# Optional comma-separated exact trusted origins; requires APP_URL. No paths,
# trailing slashes, wildcards or credentials. Leave blank for local development.
ADDITIONAL_APP_ORIGINS=
# Production domain configuration:
# APP_URL=https://wheresmydistrict.com
# ADDITIONAL_APP_ORIGINS=https://www.wheresmydistrict.com,https://district-lookup-production.up.railway.app
# Railway: attach a persistent volume at /data and set DATA_DIR=/data
DATA_DIR=.data
# Salted scrypt hashes for private review access; generate using lib/security passwordHash.
RP_REVIEW_PASSWORD_HASH=
MARTINEZ_REVIEW_PASSWORD_HASH=
