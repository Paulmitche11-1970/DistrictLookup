# Generate independent random values: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=replace-with-at-least-32-random-characters
ADMIN_SETUP_TOKEN=replace-with-a-separate-random-setup-token
APP_URL=http://localhost:3000
# Railway: attach a persistent volume at /data and set DATA_DIR=/data
DATA_DIR=.data
